# Copy to .env.local (gitignored) and fill in. Never commit real keys.
# Used only by src/app/api/report/. Any OpenAI-compatible endpoint works.
# Without these variables the app still works: the report route serves cached reports.

# Default: Groq free tier (no payment method on the account = no charges, over-limit requests get HTTP 429).
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
# One model, or several separated by commas: when the first is rate limited (HTTP 429) or fails, the next is tried
# before the cached report is served. List only models of similar quality: on 2026-11-15 the smaller
# openai/gpt-oss-20b passed the automatic checks but misread counts and citations, so it is not listed here.
LLM_MODEL=openai/gpt-oss-120b
# Optional. Sent as reasoning_effort. Unset = "low" for gpt-oss models and nothing for others; "none" = never send it.
# LLM_REASONING_EFFORT=low

# Optional second provider, tried when every model above failed or is rate limited. Same three settings.
# Example: Google Gemini through its OpenAI-compatible endpoint (API key from Google AI Studio).
# LLM_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_MODEL=<a model id from the provider>

# Alternative for local development: Ollama on your own GPU.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=<a model you pulled>

# Public URL of the source repository, used for the links on the About page.
# Optional: on Vercel it is derived from the connected Git repository; without it the links are plain text.
NEXT_PUBLIC_REPO_URL=
