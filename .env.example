# Copy to .env.local (gitignored) and fill in. Never commit real keys.
# Used only by src/app/api/report/. Any OpenAI-compatible endpoint works.
# Without these variables the app still works: the report route serves cached reports.

# Default: Groq free tier (no payment method on the account = no charges, over-limit requests get HTTP 429).
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Alternative for local development: Ollama on your own GPU.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=<a model you pulled>
